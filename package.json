  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "dev": "npx concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm install --include=dev --prefix server && npm run build --prefix server",
    "build:client": "npm install --include=dev --prefix client && npm run build --prefix client",
    "start": "npm start --prefix server",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
